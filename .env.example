# =========================================================
# AgriSaathi AI — Environment Variables Template
# Copy this file to .env and fill in real values locally.
# NEVER commit .env or real credentials.
# =========================================================

# ── Supabase ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-side Supabase (backend only; never expose to client)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ── FastAPI Backend URL ───────────────────────────────────
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# ── LLM Providers ─────────────────────────────────────────
# Local Ollama (development only)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT_SECONDS=60

# Groq Cloud (optional)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# ── Weather API ───────────────────────────────────────────
OPENWEATHER_API_KEY=

# ── RAG Configuration ─────────────────────────────────────
RAG_CHUNK_SIZE=350
RAG_CHUNK_OVERLAP=70
RAG_TOP_K=3
RAG_SIMILARITY_THRESHOLD=4.5

# ── Security ──────────────────────────────────────────────
# Production-safe defaults: authentication is required.
ENFORCE_JWT_AUTH=true
DEV_MODE=false
DEV_ALLOW_INSECURE_AUTH=false
# Comma-separated exact origins. Never use '*'.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Optional: Notification Services ──────────────────────
TELEGRAM_BOT_TOKEN=

# ── MQTT Broker ───────────────────────────────────────────
MQTT_BROKER_HOST=
MQTT_BROKER_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=true
MQTT_CA_CERT=
MQTT_CLIENT_CERT=
MQTT_CLIENT_KEY=
MQTT_UPLINK_TOPIC=agrisaathi/nodes/{device_id}/telemetry
MQTT_DOWNLINK_TOPIC=agrisaathi/nodes/{device_id}/commands
MQTT_STATUS_TOPIC=agrisaathi/nodes/{device_id}/status
