# =========================================================
# AgriSaathi AI — Environment Variables Template
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file containing real keys.
# =========================================================

# ── Supabase ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-side Supabase (backend only, never expose to client)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# ── FastAPI Backend URL ───────────────────────────────────
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# ── LLM Providers (choose ONE for cloud deployment) ──────

# Option A: Local Ollama (development only)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT_SECONDS=60

# Option B: Groq Cloud (for Render deployment)
# Get free key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# ── Weather API ───────────────────────────────────────────
# Get free key at https://openweathermap.org/api
OPENWEATHER_API_KEY=

# ── RAG Configuration ─────────────────────────────────────
RAG_CHUNK_SIZE=350
RAG_CHUNK_OVERLAP=70
RAG_TOP_K=3
RAG_SIMILARITY_THRESHOLD=4.5

# ── Security ──────────────────────────────────────────────
ENFORCE_JWT_AUTH=false
JWT_SECRET=your-jwt-secret-here

# ── Optional: Notification Services ─────────────────
TELEGRAM_BOT_TOKEN=

# ── MQTT Broker ───────────────────────────────────────────
MQTT_BROKER_HOST=broker.hivemq.com
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PREFIX=agrisaathi/esp32
